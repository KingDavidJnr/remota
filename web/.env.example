# ── Backend ───────────────────────────────────────────────────────────────────
# Base URL of the deployed backend (no trailing slash)
VITE_BACKEND_URL=https://api.remota.quickdesk.tech

# ── TURN server (NAT traversal) ───────────────────────────────────────────────
# All three must be set for TURN to be enabled; omit to use STUN-only.
# TURN URL format: turn:<host>:<port>  or  turns:<host>:<port> (TLS)
VITE_TURN_URL=turn:turn.remota.quickdesk.tech:3478
VITE_TURN_USERNAME=remota
VITE_TURN_PASSWORD=your-coturn-credential-here
