# ── Required ──────────────────────────────────────────────────────────────────
# WebSocket base URL of the backend (wss:// in production)
REMOTA_WS_URL=wss://api.remota.quickdesk.tech

# Room token — passed by the participant after accepting the join link
# (also accepted as the second CLI argument)
REMOTA_TOKEN=

# ── TURN server (NAT traversal) ───────────────────────────────────────────────
# All three must be set for TURN to be used; omit to fall back to STUN only.
REMOTA_TURN_URL=turn:turn.remota.quickdesk.tech:3478
REMOTA_TURN_USER=remota
REMOTA_TURN_PASS=your-coturn-credential-here
