# ── Build-time environment variables ─────────────────────────────────────────
# These are set by the DEVELOPER when compiling the binary, not by the end user.
# The values are baked into the .exe at compile time.
# End users download and run the binary — they configure nothing.
#
# Set these in your shell before running `cargo build --release`:
#   $env:REMOTA_WS_URL  = "wss://api.remota.quickdesk.tech"
#   $env:REMOTA_TURN_URL  = "turn:turn.remota.quickdesk.tech:3478"
#   $env:REMOTA_TURN_USER = "remota"
#   $env:REMOTA_TURN_PASS = "your-coturn-credential"

# ── Required ──────────────────────────────────────────────────────────────────
REMOTA_WS_URL=wss://api.remota.quickdesk.tech

# ── Optional (TURN — for NAT traversal) ──────────────────────────────────────
# All three must be set together for TURN to be included in the build.
REMOTA_TURN_URL=turn:turn.remota.quickdesk.tech:3478
REMOTA_TURN_USER=remota
REMOTA_TURN_PASS=your-coturn-credential-here
