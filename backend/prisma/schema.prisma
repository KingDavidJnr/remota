generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoomStatus {
  WAITING
  PARTICIPANT_JOINED
  CONSENT_PENDING
  CONNECTING
  ACTIVE
  DISCONNECTING
  ENDED
  EXPIRED
}

model Room {
  id        String     @id @default(cuid())
  token     String     @unique
  status    RoomStatus @default(WAITING)
  createdAt DateTime   @default(now())
  expiresAt DateTime
}
