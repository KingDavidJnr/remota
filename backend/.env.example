# ── Database ──────────────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string (Settings → Database → Connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# ── Server ────────────────────────────────────────────────────────────────────
# Port the HTTP + WebSocket server listens on
PORT=4000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Vercel frontend URL — must match exactly (no trailing slash)
CORS_ORIGIN=https://remota.quickdesk.tech
